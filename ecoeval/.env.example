# 复制本文件为 .env 并填入真实值
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 评价记录数据库路径（默认 /root/EcoEval/evaluations.db）
# ECOEVAL_DB_PATH=/root/EcoEval/evaluations.db

# 主系统用户数据库路径（共享账号体系，默认 /root/web/data/evaluations.db）
# TCM_MAIN_DB_PATH=/root/web/data/evaluations.db
